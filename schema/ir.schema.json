{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://12nullacht.app/schema/ir.schema.json",
  "title": "Workout IR — Day",
  "description": "One structure for read · run · build. Every surface consumes the IR, never the text. Compiled from COACH-GRAMMAR-AND-IR.md §3. The Blood Rule is schema law: minutes/rounds are null when the text does not state them — never invented.",
  "type": "object",
  "required": ["date", "source", "schema", "resolver", "programs"],
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": { "enum": ["feed", "truecoach", "mine"] },
    "schema": { "const": 1 },
    "resolver": {
      "type": "object",
      "required": ["by", "at", "confidence"],
      "properties": {
        "by": { "type": "string" },
        "at": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "issues": { "type": "array", "items": { "type": "string" } }
      }
    },
    "hashtag": { "type": ["string", "null"] },
    "rpe": { "type": ["string", "null"] },
    "flags": { "type": "array", "items": { "enum": ["deload", "throwdown", "event"] } },
    "programs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/program" } }
  },
  "$defs": {
    "program": {
      "type": "object",
      "required": ["name", "blocks"],
      "properties": {
        "name": { "enum": ["class", "hyrox", "open gym", "event"] },
        "title": { "type": ["string", "null"] },
        "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/block" } }
      }
    },
    "block": {
      "type": "object",
      "required": ["ordinal", "kind", "segments", "raw"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 },
        "letter": { "type": ["string", "null"] },
        "kind": { "enum": ["warmup", "prehab", "strength", "skill", "gymnastic", "metcon", "conditioning", "accessories", "team", "recovery", "other"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "label": { "type": ["string", "null"] },
        "focus": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "benchmark": { "type": "boolean" },
        "minutes": { "type": ["integer", "null"], "minimum": 0 },
        "series": {
          "type": ["object", "null"],
          "required": ["n", "of"],
          "properties": { "n": { "type": "integer" }, "of": { "type": "integer" } }
        },
        "cycleNote": { "type": ["string", "null"] },
        "partner": {
          "type": ["object", "null"],
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["teams", "ygig", "synchro", "relay", "split"] },
            "note": { "type": ["string", "null"] }
          }
        },
        "optional": { "type": "boolean" },
        "bonus": { "type": "boolean" },
        "segments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/segment" } },
        "scale": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "options"],
            "properties": {
              "target": { "type": "string" },
              "options": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } },
        "raw": { "type": "string" }
      }
    },
    "segment": {
      "type": "object",
      "required": ["role", "clock", "work", "raw"],
      "properties": {
        "role": { "enum": ["main", "warmup", "buildup", "heavy", "backoff", "buyin", "cashout", "rest", "drills"] },
        "chain": { "enum": ["into", "then", "rest", null] },
        "title": { "type": ["string", "null"] },
        "intent": { "enum": ["time", "reps", "quality", "heavy", "cal", "distance", null] },
        "clock": { "$ref": "#/$defs/clock" },
        "scheme": { "oneOf": [{ "$ref": "#/$defs/scheme" }, { "type": "null" }] },
        "work": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["rows", "stations"] },
            "rows": { "type": "array", "items": { "$ref": "#/$defs/movement" } },
            "stations": { "type": "array", "items": { "$ref": "#/$defs/station" } }
          }
        },
        "riders": { "type": "array", "items": { "$ref": "#/$defs/rider" } },
        "capSec": { "type": ["integer", "null"] },
        "restAfterSec": { "type": ["integer", "null"] },
        "raw": { "type": "string" }
      }
    },
    "clock": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        { "properties": { "type": { "const": "sets" }, "sets": { "type": "integer" }, "reps": {}, "restSec": { "type": ["integer", "null"] }, "restBetweenRepsSec": { "type": ["integer", "null"] }, "groups": { "type": "array" } }, "required": ["type", "sets"] },
        { "properties": { "type": { "const": "heavy" }, "windowSec": { "type": ["integer", "null"] }, "target": { "type": "string" } }, "required": ["type", "target"] },
        { "properties": { "type": { "const": "emom" }, "everySec": { "type": "integer" }, "rounds": { "type": ["integer", "null"] }, "alternate": { "type": "boolean" }, "ranges": { "type": "array" } }, "required": ["type", "everySec"] },
        { "properties": { "type": { "const": "interval" }, "workSec": { "type": "integer" }, "restSec": { "type": "integer" }, "rounds": { "type": ["integer", "null"] }, "stationMode": { "enum": ["rotate", "circuit", "long"] } }, "required": ["type", "workSec", "restSec"] },
        { "properties": { "type": { "const": "amrap" }, "sec": { "type": "integer" }, "maxSec": { "type": ["integer", "null"] } }, "required": ["type", "sec"] },
        { "properties": { "type": { "const": "forTime" }, "rounds": { "type": ["integer", "null"] }, "capSec": { "type": ["integer", "null"] }, "roundRestSec": { "type": ["integer", "null"] }, "eachForTime": { "type": "boolean" } }, "required": ["type"] },
        { "properties": { "type": { "const": "tabata" }, "rounds": { "type": "integer" } }, "required": ["type"] },
        { "properties": { "type": { "const": "rounds" }, "rounds": { "type": "integer" }, "restSec": { "type": ["integer", "null"] }, "quality": { "type": "boolean" } }, "required": ["type", "rounds"] },
        { "properties": { "type": { "const": "clock" }, "sec": { "type": "integer" } }, "required": ["type", "sec"] },
        { "properties": { "type": { "const": "none" } }, "required": ["type"] }
      ]
    },
    "scheme": {
      "type": "object",
      "required": ["type", "steps"],
      "properties": {
        "type": { "enum": ["descending", "ascending", "wave", "climb", "pairs"] },
        "steps": { "type": "array", "items": { "type": "integer" } },
        "unit": { "enum": ["reps", "cal", "m"] },
        "by": { "type": ["integer", "null"] },
        "appliesTo": {},
        "scaled": { "type": ["array", "null"] },
        "pcts": { "type": ["array", "null"], "items": { "type": "number" } }
      }
    },
    "station": {
      "type": "object",
      "properties": {
        "n": { "type": ["integer", "null"] },
        "letter": { "type": ["string", "null"] },
        "repeat": { "type": "integer", "minimum": 1 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/movement" } },
        "sub": { "type": "array", "items": { "$ref": "#/$defs/station" } },
        "rest": { "type": "boolean" },
        "minutes": { "type": ["array", "null"] }
      }
    },
    "movement": {
      "type": "object",
      "required": ["id", "name", "qty", "load", "text"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "qty": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["reps", "cal", "m", "sec", "max", "none"] },
            "value": { "type": ["number", "null"] },
            "f": { "type": ["number", "null"] },
            "range": { "type": ["array", "null"] },
            "remaining": { "type": "boolean" },
            "maxUnit": { "enum": ["reps", "cal", "m", "sec", null] }
          }
        },
        "perSide": { "type": "boolean" },
        "sides": { "enum": ["left", "right", null] },
        "load": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["pair", "kg", "pct", "ahap", "bw", "rpe", "band", "implement", "none"] },
            "m": { "type": ["number", "null"] },
            "f": { "type": ["number", "null"] },
            "kg": { "type": ["number", "null"] },
            "pct": { "type": ["number", "null"] },
            "pctRange": { "type": ["array", "null"] },
            "pctOf": { "type": ["string", "null"] },
            "climbing": { "type": "boolean" },
            "rpe": { "type": ["string", "null"] },
            "unit": { "enum": ["kg", "cm", "in", "lb", null] }
          }
        },
        "mods": { "type": "object" },
        "parts": { "type": "array" },
        "alternatives": { "type": "array", "items": { "type": "string" } },
        "text": { "type": "string" }
      }
    },
    "rider": {
      "type": "object",
      "required": ["kind", "text"],
      "properties": {
        "kind": { "enum": ["betweenSets", "everyInterval", "addEachRound", "afterRound", "restBetweenRounds", "buyIn", "cashOut", "note"] },
        "everySec": { "type": ["integer", "null"] },
        "items": { "type": "array", "items": { "$ref": "#/$defs/movement" } },
        "text": { "type": "string" }
      }
    }
  }
}
